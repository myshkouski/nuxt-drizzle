{
  "name": "nuxt-drizzle",
  "version": "0.1.3",
  "description": "Nuxt module that integrates Drizzle ORM into the Nuxt server layer.",
  "keywords": [
    "database",
    "drizzle",
    "drizzle-orm",
    "nitro",
    "nitro-drizzle",
    "nuxt",
    "nuxt-module",
    "orm"
  ],
  "homepage": "https://github.com/myshkouski/nuxt-drizzle#readme",
  "bugs": {
    "url": "https://github.com/myshkouski/nuxt-drizzle/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myshkouski/nuxt-drizzle.git"
  },
  "workspaces": [
    "playground"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "release": "changelogen --release --push",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "nitro-drizzle": "catalog:",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.1",
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxt/kit": "catalog:",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "catalog:",
    "@nuxt/test-utils": "^4.1.0",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "lefthook": "^2.1.10",
    "nuxt": "catalog:",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.77.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
